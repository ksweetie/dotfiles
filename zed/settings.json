{
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
  "buffer_font_family": "JetBrains Mono",
  "cli_default_open_behavior": "existing_window",
  "cursor_animation": { "enabled": true },
  "diff_view_style": "unified",
  "colorize_brackets": true,
  "sticky_scroll": {
    "enabled": true,
  },
  "theme": {
    "mode": "light",
    "light": "macOS Classic Light",
    "dark": "Terafox - blurred",
  },
  "icon_theme": {
    "mode": "light",
    "light": "VSCode Icons for Zed (Dark)",
    "dark": "VSCode Icons for Zed (Dark)",
  },
  "active_pane_modifiers": {
    "inactive_opacity": 0.5,
  },
  "agent": {
    "favorite_models": [
      {
        "provider": "anthropic",
        "model": "claude-opus-5-5",
        "enable_thinking": true,
        "effort": "high",
      },
    ],
    "dock": "right",
    "profiles": {
      "ask": {
        "name": "Ask",
        "tools": {
          "search_web": true,
          "contents": true,
          "diagnostics": true,
          "fetch": true,
          "list_directory": true,
          "now": true,
          "find_path": true,
          "read_file": true,
          "open": true,
          "grep": true,
          "thinking": true,
        },
        "enable_all_context_servers": false,
        "context_servers": {
          "mcp-server-github": {
            "tools": {
              "search_users": true,
              "search_repositories": true,
              "search_issues": true,
              "search_code": true,
              "list_secret_scanning_alerts": true,
              "list_pull_requests": true,
              "list_issues": true,
              "list_commits": true,
              "list_code_scanning_alerts": true,
              "list_branches": true,
              "get_secret_scanning_alert": true,
              "get_pull_request_status": true,
              "get_pull_request_reviews": true,
              "get_pull_request_files": true,
              "get_pull_request_comments": true,
              "get_pull_request": true,
              "get_code_scanning_alert": true,
              "get_commit": true,
              "get_file_contents": true,
              "get_me": true,
              "get_issue_comments": true,
              "get_issue": true,
            },
          },
          "postgres-context-server": {
            "tools": {
              "query": true,
              "pg-schema": true,
            },
          },
        },
      },
    },
    "default_profile": "write",
    "button": false,
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "anthropic",
      "model": "claude-opus-5-5",
    },
  },
  "base_keymap": "VSCode",
  "buffer_font_size": 16.0,
  "buffer_line_height": { "custom": 1.5 },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "context_servers": {
  },
  "current_line_highlight": "none",
  "cursor_blink": false,
  "debugger": {
    "button": false,
  },
  "diagnostics": {
    "include_warnings": false,
  },
  "file_scan_exclusions": [".yarn/releases/*.cjs", "**/*.gd.uid"],
  "file_scan_inclusions": [".env"],
  "format_on_save": "on",
  "git": {
    "inline_blame": {
      "show_commit_summary": true,
    },
  },
  "git_panel": {
    "dock": "left",
    "collapse_untracked_diff": false,
    "sort_by_path": true,
    "tree_view": true,
    "button": false,
    "default_width": 500,
  },
  "global_lsp_settings": {
    "button": true,
  },
  "gutter": {
    "line_numbers": true,
    "breakpoints": false,
    "runnables": false,
    "folds": false,
  },
  "inline_code_actions": false,
  "languages": {
    "JavaScript": {
      "language_servers": ["!eslint", "!typescript-language-server", "!vtsls"],
      "prettier": { "allowed": false },
    },
    "GDScript": {
      "hard_tabs": true,
      "formatter": {
        "external": {
          "command": "gdformat",
          "arguments": ["-", "--line-length", "120"],
        },
      },
    },
    "Markdown": {
      "format_on_save": "off",
    },
    "Ruby": {
      "language_servers": ["ruby-lsp", "rubocop", "!solargraph"],
    },
    "Rust": {
      "tab_size": 4,
    },
    "SQL": {
      "format_on_save": "off",
    },
    "YAML": {
      "format_on_save": "off",
    },
  },
  "lsp": {
    "rubocop": {
      "initialization_options": {
        "safeAutocorrect": false,
      },
    },
    "ruby-lsp": {
      "initialization_options": {
        "experimentalFeaturesEnabled": true,
        "enabledFeatures": {
          "diagnostics": false,
          "onTypeFormatting": false,
        },
      },
    },
  },
  "outline_panel": {
    "dock": "left",
    "button": false,
    "default_width": 500,
  },
  "preferred_line_length": 120,
  "preview_tabs": {
    "enable_preview_file_from_code_navigation": false,
    "enable_preview_from_multibuffer": false,
    "enable_preview_from_project_panel": false,
    "enabled": false,
  },
  "project_panel": {
    "dock": "left",
    "auto_reveal_entries": false,
    "button": false,
    "default_width": 500,
    "file_icons": true,
    "git_status_indicator": true,
    "indent_size": 12,
  },
  "relative_line_numbers": "enabled",
  "scroll_beyond_last_line": "off",
  "scrollbar": {
    "show": "system",
    "axes": {
      "horizontal": false,
    },
  },
  "search": { "button": false },
  "status_bar": {
    "active_language_button": false,
    "cursor_position_button": false,
    "experimental.show": false,
    "line_endings_button": false,
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "tab_size": 2,
  "terminal": {
    "button": false,
    "dock": "right",
    "font_family": "FiraCode Nerd Font Mono",
  },
  "theme_overrides": {
    "Catppuccin Frappé": {
      "syntax": {
        "comment": { "font_style": "italic" },
        "comment.doc": { "font_style": "italic" },
        "function": { "font_style": "italic" },
        "function.method": { "font_style": "italic" },
        "variable.special": { "font_style": "normal" },
      },
    },
    "macOS Classic Light": {
      "syntax": {
        "comment": { "font_style": "italic" },
        "comment.doc": { "font_style": "italic" },
        "function": { "font_style": "italic" },
      },
      "version_control.added": "#27a657ff",
      "version_control.modified": "#d3b020ff",
      "version_control.deleted": "#e06c76ff",
      "version_control.conflict_marker.ours": "#a1c1811a",
      "version_control.conflict_marker.theirs": "#74ade81a",
    },
    // https://github.com/teziovsky/zed-one-hunter-theme/blob/main/themes/one-hunter.json
    "One Hunter Classic": {
      "tab.active_background": "#191d21",
    },
    // https://github.com/cange/nightfox.zed
    // Stock highlight alphas are far too low against the dark blurred background
    // (selection 1.44:1, search match 1.09:1). Same hues, higher alpha.
    "Terafox - blurred": {
      "players": [
        { "cursor": "#7aa4a1", "background": "#7aa4a18c", "selection": "#7aa4a18c" },
        { "cursor": "#a1cdd8", "background": "#a1cdd88c", "selection": "#a1cdd880" },
        { "cursor": "#5a93aa", "background": "#5a93aa8c", "selection": "#5a93aa8c" },
        { "cursor": "#ff8349", "background": "#ff83498c", "selection": "#ff834980" },
        { "cursor": "#fda47f", "background": "#fda47f8c", "selection": "#fda47f80" },
        { "cursor": "#cb7985", "background": "#cb79858c", "selection": "#cb79858c" },
        { "cursor": "#ad5c7c", "background": "#ad5c7c8c", "selection": "#ad5c7c8c" },
        { "cursor": "#e85c51", "background": "#e85c518c", "selection": "#e85c518c" },
      ],
      "search.match_background": "#fda47f59",
      "search.active_match_background": "#ff83498c",
      "element.selection_background": "#7aa4a159",
      "editor.document_highlight.read_background": "#7aa4a140",
      "editor.document_highlight.write_background": "#fda47f4d",
    },
  },
  "title_bar": {
    "show_user_menu": false,
    "show_branch_status_icon": true,
    "show_project_items": false,
    "show_user_picture": false,
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
  },
  "ui_font_size": 16,
  "ui_font_family": "JetBrains Mono",
  "vertical_scroll_margin": 5,
  "vim_mode": true,
  "wrap_guides": [120],
}
